<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>IconSetter</RootNamespace>
    <AssemblyName>IconSetter</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>

    <!-- Makes "dotnet publish" (see build.bat) produce ONE standalone .exe            -->
    <!-- that runs on any Windows 10/11 x64 machine with no .NET install required.     -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContainedApplicationClosesAfterInit>false</SelfContainedApplicationClosesAfterInit>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\favicon.ico" />
    <None Remove="favicon.ico" />
    <None Remove="Assets\btn_prev.png" />
    <None Remove="Assets\btn_next.png" />
    <None Remove="Assets\btn_random.png" />
    <None Remove="Assets\badge_folder.png" />
    <None Remove="Assets\icon_search.png" />
    <None Remove="Assets\icon_options.png" />
    <None Remove="Assets\icon_recent.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\favicon.ico" />
    <Content Include="favicon.ico" />
    <Resource Include="Assets\btn_prev.png" />
    <Resource Include="Assets\btn_next.png" />
    <Resource Include="Assets\btn_random.png" />
    <Resource Include="Assets\badge_folder.png" />
    <Resource Include="Assets\icon_search.png" />
    <Resource Include="Assets\icon_options.png" />
    <Resource Include="Assets\icon_recent.png" />
  </ItemGroup>

</Project>
