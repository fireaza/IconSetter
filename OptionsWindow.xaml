<Window x:Class="IconSetter.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">
        <CheckBox x:Name="chkConvertNonIco" IsChecked="True"
                  Content="Convert images named 'icon*' (png/jpg/bmp) to .ico"
                  ToolTip="Looks for files like icon.png, icon2.jpg, etc. and builds a multi-resolution .ico from each. The source image is then sent to the Recycle Bin so re-running the scan won't create duplicate .ico files."/>

        <Separator Margin="0,10" Opacity="0.4"/>

        <CheckBox x:Name="chkEnrichIco" Content="Add missing sizes to existing .ico files (up to 256px)"
                  ToolTip="If an .ico only has one resolution (often just 256px), rebuilds it with the full 256/128/64/48/32/16 set so it looks sharp everywhere in Explorer."/>
        <CheckBox x:Name="chkKeepBackupIco" Content="Keep a .bak copy of the original .ico" IsChecked="True"
                  Margin="20,0,0,0" IsEnabled="{Binding IsChecked, ElementName=chkEnrichIco}"/>

        <Separator Margin="0,10" Opacity="0.4"/>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="When a folder has multiple icons:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cmbIconMode" Width="200" SelectedIndex="0"
                      ToolTip="How to auto-pick which icon a folder should use when there's more than one icon*.ico candidate.">
                <ComboBoxItem Content="Keep current selection"/>
                <ComboBoxItem Content="Use the first one found"/>
                <ComboBoxItem Content="Pick one at random"/>
                <ComboBoxItem Content="Use the most recently modified"/>
            </ComboBox>
        </StackPanel>

        <Separator Margin="0,10" Opacity="0.4"/>

        <CheckBox x:Name="chkHideIcoAfterApply" Content="Set .ico to &quot;hidden&quot; after customisation" IsChecked="True"
                  ToolTip="When on (default), the .ico file used to customize a folder gets marked as hidden - the same thing Explorer's own 'Change Icon' dialog does. Turn off to leave .ico files visible."/>

        <Separator Margin="0,10" Opacity="0.4"/>

        <CheckBox x:Name="chkDarkMode" Content="Dark mode"
                  ToolTip="Switch the gallery to a dark background, similar to Explorer's dark theme."/>

        <Separator Margin="0,10" Opacity="0.4"/>

        <CheckBox x:Name="chkAlwaysShowUpToDate" Content="Always show up-to-date folders"
                  ToolTip="Makes the 'Show up-to-date folders' toggle start turned on every time you launch Icon Setter, instead of off."/>

        <CheckBox x:Name="chkAlwaysShowMultipleIcons" Content="Always show folders with multiple .ico"
                  ToolTip="Makes the 'Has multiple .ico' chip start turned on every time you scan a folder, instead of off. You can still turn it back off by clicking the chip."/>

        <Button x:Name="btnDone" Content="Done" Style="{StaticResource PrimaryButtonStyle}"
                Width="100" Height="36" HorizontalAlignment="Right" Margin="0,20,0,0"
                Click="btnDone_Click"/>
    </StackPanel>
</Window>
